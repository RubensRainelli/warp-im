# AppRun entrypoint for Warp_IM.AppDir / Warp_IM-x86_64.AppImage

set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
export WARP_THEMES_DIR="${HERE}/usr/share/warp-im/themes"
export WARP_LICENSE_DIR="${HERE}/usr/share/doc/warp-im"
export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH:-}"

exec "${HERE}/usr/bin/warp-im" "$@"
